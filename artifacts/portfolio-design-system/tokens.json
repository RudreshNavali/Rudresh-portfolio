{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f7f7f2" },
      "foreground": { "$value": "#17232d" },
      "border": { "$value": "#d9e2e3" },
      "card": { "$value": "#fbfcf8" },
      "cardForeground": { "$value": "#17232d" },
      "popover": { "$value": "#fbfcf8" },
      "popoverForeground": { "$value": "#17232d" },
      "primary": {
        "$value": "#176b9b",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#f7fbfc" },
      "secondary": { "$value": "#e4f1f4" },
      "secondaryForeground": { "$value": "#17445a" },
      "muted": { "$value": "#edf3f3" },
      "mutedForeground": { "$value": "#5c6f77" },
      "accent": { "$value": "#d8f36a" },
      "accentForeground": { "$value": "#17232d" },
      "destructive": { "$value": "#ef4444" },
      "destructiveForeground": { "$value": "#fafafa" },
      "input": { "$value": "#d9e2e3" },
      "ring": { "$value": "#176b9b" },
      "chart1": { "$value": "#e8643c" },
      "chart2": { "$value": "#218f8b" },
      "chart3": { "$value": "#176b9b" },
      "chart4": { "$value": "#d8f36a" },
      "chart5": { "$value": "#f0a33b" },
      "sidebar": { "$value": "#eef4f2" },
      "sidebarForeground": { "$value": "#31525f" },
      "sidebarBorder": { "$value": "#d9e2e3" },
      "sidebarPrimary": { "$value": "#176b9b" },
      "sidebarPrimaryForeground": { "$value": "#f7fbfc" },
      "sidebarAccent": { "$value": "#d8f36a" },
      "sidebarAccentForeground": { "$value": "#17232d" },
      "sidebarRing": { "$value": "#176b9b" }
    },
    "dark": {
      "background": { "$value": "#08141d" },
      "foreground": { "$value": "#f3f8f9" },
      "border": { "$value": "#203745" },
      "card": { "$value": "#0d202b" },
      "cardForeground": { "$value": "#f3f8f9" },
      "popover": { "$value": "#0d202b" },
      "popoverForeground": { "$value": "#f3f8f9" },
      "primary": { "$value": "#d8f36a" },
      "primaryForeground": { "$value": "#13212b" },
      "secondary": { "$value": "#123142" },
      "secondaryForeground": { "$value": "#d9edf1" },
      "muted": { "$value": "#0f2530" },
      "mutedForeground": { "$value": "#9eb5bd" },
      "accent": { "$value": "#e8643c" },
      "accentForeground": { "$value": "#fff4ee" },
      "destructive": { "$value": "#7f1d1d" },
      "destructiveForeground": { "$value": "#fafafa" },
      "input": { "$value": "#203745" },
      "ring": { "$value": "#d8f36a" },
      "chart1": { "$value": "#5fb5d9" },
      "chart2": { "$value": "#43c9a2" },
      "chart3": { "$value": "#e8643c" },
      "chart4": { "$value": "#d8f36a" },
      "chart5": { "$value": "#f0a33b" },
      "sidebar": { "$value": "#0d202b" },
      "sidebarForeground": { "$value": "#d9edf1" },
      "sidebarBorder": { "$value": "#203745" },
      "sidebarPrimary": { "$value": "#d8f36a" },
      "sidebarPrimaryForeground": { "$value": "#13212b" },
      "sidebarAccent": { "$value": "#123142" },
      "sidebarAccentForeground": { "$value": "#f3f8f9" },
      "sidebarRing": { "$value": "#d8f36a" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Default UI and body typeface."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
